# CyberGuard AI — environment configuration
# Copy to backend/.env and edit. Never commit real secrets.

APP_ENV=development
APP_NAME=CYBERGUARD
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# SQLite works with zero setup. For PostgreSQL set DATABASE_URL, for example:
# DATABASE_URL=postgresql+psycopg://aegis:change-me@localhost:5432/aegis_sentinel

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_MINUTES=720

# Seeds the initial intelligence corpus on an empty database.
SEED_INTELLIGENCE_CORPUS=true

# Live connectors. A failed fetch is recorded as failed; nothing is substituted.
ENABLE_LIVE_THREAT_FEEDS=true
NVD_API_KEY=
CISA_KEV_ENABLED=true
EPSS_ENABLED=true
MITRE_ATTACK_ENABLED=true
CSIRT_ENABLED=true

# Optional enrichment keys (server-side only; never exposed to the browser)
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=

# Aegis AI. The key stays on the server; the browser only ever sees connection state.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_OUTPUT_TOKENS=1600
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_RETRIES=2

# Optional email notifications
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# APP_ENV=production requires a strong JWT_SECRET_KEY and HTTPS CORS origins.
